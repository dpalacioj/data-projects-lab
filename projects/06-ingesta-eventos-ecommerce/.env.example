# Archivo de ejemplo para variables de entorno del proyecto 06.
# Copialo a `.env` (en esta misma carpeta) y ajusta los valores.
#
#     cp .env.example .env
#
# El archivo `.env` real NO se commitea (esta en el .gitignore del repo).
# Esta es la forma estandar en produccion de manejar credenciales: fuera del codigo,
# fuera de git, inyectadas por el entorno.

# -----------------------------------------------------------------------------
# Backend por defecto: SQLite (cero setup, funciona el dia 1).
# -----------------------------------------------------------------------------
# SQLite es una base de datos relacional de un solo archivo. No tiene usuario
# ni password porque el control de acceso lo hace el sistema de archivos.
# La usamos como backend didactico: mismo SQL, misma libreria (SQLAlchemy),
# cero instalacion.
DATABASE_URL=sqlite:///data/db/eventos.db

# -----------------------------------------------------------------------------
# Backend alternativo: PostgreSQL (como en produccion).
# -----------------------------------------------------------------------------
# Para cambiar a Postgres, comenta la linea de SQLite de arriba y descomenta
# estas. Necesitas una base real corriendo (ver seccion "Postgres con Docker"
# del README).
#
# DB_USER=app_eventos
# DB_PASSWORD=cambia_esto_en_produccion
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=eventos
# DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
#
# Nota: la URL de Postgres NUNCA debe estar hardcodeada en el codigo. Siempre
# se arma desde variables de entorno como aqui arriba. Si abres un PR con una
# password en texto plano, cualquier revisor te lo va a devolver.

# -----------------------------------------------------------------------------
# Parametros del generador de datos sinteticos.
# -----------------------------------------------------------------------------
# Numero de dias de historico a generar. Con los valores por defecto se superan
# los 900.000 registros (clientes + pedidos + items + productos).
EVENTOS_DIAS=60
EVENTOS_PEDIDOS_POR_DIA=1700
EVENTOS_CLIENTES=20000
EVENTOS_PRODUCTOS=500
EVENTOS_SEMILLA=42
