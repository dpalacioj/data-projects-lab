# Variables de entorno para el cliente LLM real (cuaderno 08).
# Copia este archivo como `.env` y rellena los valores con tu proveedor.
# El `.env` NUNCA se commitea (ver `.gitignore`).
#
# El adaptador `cliente_openai_compatible` cubre cualquier servicio con
# API compatible con el formato de chat de OpenAI (DeepSeek, OpenAI,
# Groq, Ollama local, etc.). Cambia los tres valores para cambiar de
# proveedor; nunca aparecen en el codigo.

LLM_BASE_URL=https://api.ejemplo.com/v1
LLM_API_KEY=sk-rellena-con-tu-clave
LLM_MODELO=nombre-del-modelo-aqui
