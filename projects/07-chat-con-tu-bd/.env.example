# Archivo de ejemplo para variables de entorno del proyecto 07.
# Copialo a `.env` (en esta misma carpeta) y ajusta los valores.
#
#     cp .env.example .env
#
# El archivo `.env` real NO se commitea (esta en el .gitignore del repo).

# -----------------------------------------------------------------------------
# Proveedor de LLM
# -----------------------------------------------------------------------------
# "ollama" -> modelo local via Ollama (default; 100% open source, sin API keys).
# "hf"     -> HuggingFace Inference API (requiere HF_TOKEN; usa el free tier).
# "fake"   -> LLM falso que devuelve respuestas fijas (solo para tests).
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Ollama (default)
# -----------------------------------------------------------------------------
# Modelo que Ollama tiene descargado. Descargalo antes con:
#     ollama pull qwen2.5:7b
# Alternativas probadas: "llama3.1:8b", "qwen2.5:7b", "phi3:mini" (mas ligero).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# HuggingFace (fallback si no puedes correr Ollama)
# -----------------------------------------------------------------------------
# Crea un token gratuito en https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# -----------------------------------------------------------------------------
# Base de datos (la que cargamos en el proyecto 06)
# -----------------------------------------------------------------------------
# Por defecto apunta al SQLite del proyecto 06. Si cambiaste el 06 a Postgres,
# aqui va la misma URL.
DATABASE_URL=sqlite:///../06-ingesta-eventos-ecommerce/data/db/eventos.db

# -----------------------------------------------------------------------------
# Parametros del agente
# -----------------------------------------------------------------------------
# Numero maximo de reintentos del agente de LangGraph cuando el SQL falla.
AGENTE_MAX_REINTENTOS=3
# Temperatura del LLM (0 = deterministico, ideal para generar SQL).
LLM_TEMPERATURA=0.0
